#!/usr/bin/env bash


### Reglas de entrada para nodos K3

set -euo pipefail

# Comprobar que firewalld está instalado y activo
if ! command -v firewall-cmd >/dev/null 2>&1; then
  echo "ERROR: firewall-cmd no está instalado. Instala firewalld antes de ejecutar este script." >&2
  exit 1
fi

if ! systemctl is-active --quiet firewalld; then
  echo "ERROR: firewalld no está activo. Ejecuta: sudo systemctl enable --now firewalld" >&2
  exit 1
fi

echo "==> Configurando reglas permanentes para nodos K3s..."

# Redes de pods y servicios de Kubernetes en la zona trusted
sudo firewall-cmd --permanent --zone=trusted --add-source=10.42.0.0/16  # Pods
sudo firewall-cmd --permanent --zone=trusted --add-source=10.43.0.0/16  # Services

# Requerido solo para HA con etcd integrado
# Origen: servidores | Destino: servidores
sudo firewall-cmd --permanent --add-port=2379-2380/tcp

# Supervisor de K3s y servidor API de Kubernetes
# Origen: agentes | Destino: servidores
sudo firewall-cmd --permanent --add-port=6443/tcp

# Requerido solo para Flannel VXLAN
# Origen: todos los nodos | Destino: todos los nodos
sudo firewall-cmd --permanent --add-port=8472/udp

# Métricas y API de Kubelet
# Origen: todos los nodos | Destino: todos los nodos
sudo firewall-cmd --permanent --add-port=10250/tcp

# Requerido solo para Flannel WireGuard con IPv4
# Origen: todos los nodos | Destino: todos los nodos
sudo firewall-cmd --permanent --add-port=51820/udp

# Requerido solo para Flannel WireGuard con IPv6
# Origen: todos los nodos | Destino: todos los nodos
sudo firewall-cmd --permanent --add-port=51821/udp

# Requerido únicamente para registro distribuido integrado (Spegel)
# Origen: todos los nodos | Destino: todos los nodos
sudo firewall-cmd --permanent --add-port=5001/tcp

echo "==> Recargando firewalld..."
sudo firewall-cmd --reload

echo "==> Reglas activas para puertos K3s:"
sudo firewall-cmd --list-ports
sudo firewall-cmd --zone=trusted --list-sources

echo "==> Configuración completada."

