#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config"

if [ ! -d "$CONFIG_DIR" ]; then
  echo "Error: Directory $CONFIG_DIR does not exist." >&2
  exit 1
fi

# Lista de exclusiones que se puede alimentar manualmente
EXCLUDE_DIRS=(
  "$HOME/.config/chezmoi"
  "$HOME/.config/xfce4"
  "$HOME/.config/mozilla"
  "$HOME/.config/tmux"
  "$HOME/.config/alacritty"
)

# Funcion para verificar si un directorio esta excluido
is_excluded() {
  local dir="$1"
  for exclude in "${EXCLUDE_DIRS[@]}"; do
    if [[ "$dir" == "$exclude" ]] || [[ "$dir" == */"$exclude" ]] || [[ "$dir" == "$HOME/$exclude" ]]; then
      return 0
    fi
  done
  return 1
}

# Obtener todos los subdirectorios y filtrar las exclusiones
mapfile -t ALL_CONFIG_DIRS < <(find "$CONFIG_DIR" -mindepth 1 -maxdepth 1 -type d | sort)
CONFIG_DIRS=()

for dir in "${ALL_CONFIG_DIRS[@]}"; do
  if ! is_excluded "$dir"; then
    CONFIG_DIRS+=("$dir")
  fi
done

print_help() {
  echo "Usage: $0 [OPTION]"
  echo "Manage ~/.config subdirectories using chezmoi with exclusions."
  echo ""
  echo "Options:"
  echo "  --list    Show all filtered subdirectories in the array"
  echo "  --add     Run 'chezmoi add' for each filtered subdirectory"
  echo "  -h        Display this help message"
}

list_dirs() {
  echo "Subdirectories in $CONFIG_DIR (excluding specified paths):"
  for dir in "${CONFIG_DIRS[@]}"; do
    echo "  $dir"
  done
}

add_dirs() {
  echo "Adding filtered subdirectories to chezmoi..."
  for dir in "${CONFIG_DIRS[@]}"; do
    echo "Executing: chezmoi add \"$dir\""
    chezmoi add "$dir"
  done
}

case "$1" in
--list)
  list_dirs
  ;;
--add)
  add_dirs
  ;;
-h | --help)
  print_help
  ;;
*)
  echo "Error: Invalid or missing argument." >&2
  print_help
  exit 1
  ;;
esac
